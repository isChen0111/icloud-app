# npm 国内镜像配置（仅作用于 server/ 目录下的 npm install）
# 加速 better-sqlite3 / sharp 的预编译二进制下载
# 注：162MB 的 ffmpeg-full（BtbN）npmmirror 未收录，postinstall 仍走 GitHub Release 落到 vendor/

registry=https://registry.npmmirror.com

# better-sqlite3 预编译 .node 二进制镜像
better_sqlite3_binary_host=https://registry.npmmirror.com/-/binary/better-sqlite3

# sharp libvips 预编译镜像（新版 sharp 主要走 npm 包，这里是兼容老版）
sharp_libvips_binary_host=https://registry.npmmirror.com/-/binary/sharp-libvips
