# ============================================================
# 可选参数配置模板
# 用法：复制本文件改名为 .env，按需取消注释并修改
#   Copy-Item .env.example .env
#   notepad .env
# .env 不会提交到 git（含个人路径）
# 启动脚本已带 --env-file-if-exists=.env，文件不存在也能正常启动
# 优先级：命令行手动设置 > 本文件 > 代码里的默认值
#
# ⚠️ 照片库 / 缓存 / 数据库路径不支持在这里配置（2026-11-01 移除
#    PHOTO_LIBRARY / CACHE_DIR / DB_PATH / META_DB_PATH）：
#    多照片库下每库的照片目录、cache、cookie、library.db 与注册表 meta.db
#    通过绝对路径绑定，路径由建库时按项目根派生并写入 meta.db。
#    单独用环境变量挪动其中一项会造成「注册表在一处、库文件在另一处」的
#    半迁移状态。要整体搬家请连同项目目录与 server/cache 一起移动。
# ============================================================

# 监听端口
# 默认：8899
# PORT=8899

# 监听地址：默认 0.0.0.0（同一局域网设备可访问，配合同源 Origin 判定）
# 仅本机访问可设 127.0.0.1（局域网设备连接被拒）
# HOST=0.0.0.0

# 扫描上限（调试用，0=全量）
# SCAN_LIMIT=0

# 导入上传：单文件大小上限（字节），默认 0 = 不限
# MAX_UPLOAD_BYTES=0

# BtbN ffmpeg full 解压目录（含 libheif 的 ffmpeg.exe / ffprobe.exe）
# 默认：项目根\server\vendor\ffmpeg-full
# FFMPEG_DIR=F:\iPhone\icloud-app\server\vendor\ffmpeg-full
# 也可直接指定可执行文件：
# FFMPEG_PATH=F:\iPhone\icloud-app\server\vendor\ffmpeg-full\...\bin\ffmpeg.exe
# FFPROBE_PATH=F:\iPhone\icloud-app\server\vendor\ffmpeg-full\...\bin\ffprobe.exe

# icloudpd 可执行文件（默认：项目根\server\vendor\icloudpd-1.32.3-windows-amd64.exe）
# ICLOUDPD_EXE=F:\iPhone\icloud-app\server\vendor\icloudpd-1.32.3-windows-amd64.exe
