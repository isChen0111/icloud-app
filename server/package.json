{
  "name": "icloud-app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "本地 iCloud 照片浏览器 · 后端（Node.js + Fastify + SQLite + sharp）",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "scan": "tsx --env-file-if-exists=.env src/cli-scan.ts",
    "test": "node --import tsx --test src/pipeline/thumbnailScheduler.test.ts",
    "fix-size": "tsx scripts/fix-asset-size.ts",
    "fix-thumbs": "tsx scripts/rebuild-orientation-thumbs.ts",
    "postinstall": "powershell -ExecutionPolicy Bypass -File scripts/install-ffmpeg-full.ps1"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "exifr": "^7.1.3",
    "fastify": "^5.2.1",
    "p-queue": "^8.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
