{
  "name": "icloud-app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地 iCloud 照片浏览器 · 后端（Node.js + Fastify + SQLite + sharp）",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "scan": "tsx --env-file-if-exists=.env cli-scan.ts",
    "fix-size": "tsx scripts/fix-asset-size.ts",
    "fix-thumbs": "tsx scripts/rebuild-orientation-thumbs.ts",
    "postinstall": "powershell -ExecutionPolicy Bypass -File scripts/install-ffmpeg-full.ps1"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "exifr": "^7.1.3",
    "fastify": "^5.2.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "p-queue": "^8.0.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
